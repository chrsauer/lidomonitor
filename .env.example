# --- Nodes (kommagetrennt, erster = bevorzugt, Rest = Failover) ---
BEACON_URLS=http://localhost:5052,http://beacon2:5052
EXECUTION_URLS=http://localhost:8545,http://el2:8545,http://el3:8545

# --- Lido ---
OPERATOR_ID=17
NOR_ADDRESS=0x55032650b14df07b85bF18A3a3eC8E0Af2e028d5
# Keys API nur als Notfall-Quelle, wenn kein EL-Node erreichbar ist (false = nie)
KAPI_FALLBACK=true

# --- Telegram ---
# Bot via @BotFather anlegen und als Admin in den Channel aufnehmen.
# Chat-ID: @channelname (öffentlich) oder -100xxxxxxxxxx (privat)
TELEGRAM_BOT_TOKEN=123456:ABC...
TELEGRAM_CHAT_ID=-100xxxxxxxxxx
# Warnungen ohne Ton zustellen, nur KRITISCH klingelt
WARN_SILENT=true

# --- Schweregrad ---
# KRITISCH, wenn derselbe VC so viele seiner Duties in Folge verpasst.
# Einzelne Fehler verschiedener VCs bleiben eine Warnung.
CRIT_STREAK=2

# --- Optional ---
CONFIRM_SLOTS=3
DAILY_SUMMARY_HOUR_UTC=7
NOTIFY_PROPOSED=false
ALERT_AFTER_ERRORS_SEC=300
KEYS_REFRESH_SEC=21600
EXPLORER_URL=https://beaconcha.in
